# ===================================================
# Telegram API Configuration
# ===================================================

# Telegram API ID and Hash
# Get from https://my.telegram.org/apps
API_ID=YOUR_API_ID
API_HASH=abcdef1234567890abcdef1234567890

# Phone number for user-session auth (international format)
# Alternative: set BOT_TOKEN below
PHONE=+79001234567

# Bot token from @BotFather (alternative to PHONE)
#BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================================
# Channel Configuration
# ===================================================

# Channel list has moved to .env.json → "channels": [{"url": "...", "name": "..."}]
# CHANNELS env var is still supported as a fallback (comma-separated URLs/usernames).

# Default channel for view-recent / download (without --all-channels)
# Formats: @channel_name, +invite_hash, https://t.me/+xxx, numeric ID
TARGET_CHANNEL=+otRtx2aMM0ZlMTVi

# Number of recent posts to fetch by default
RECENT_POSTS_COUNT=10

# Work directory for downloaded posts
WORK_DIR=H:\TEMP\vk_vsf

# Output directory for join_video.py
# Generated filename: vk_vsf_output-YYYYMMDD-<orientation>.mp4
OUTPUT_DIR=\\server\temp

# ===================================================
# Development
# ===================================================

# Debug mode (true/false)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===================================================
# Proxy Configuration
# ===================================================

# Proxy type: mtproto | socks5 | socks4
# Leave commented out to connect directly.
# When proxies are listed in .env.json the bot uses that list and rotates automatically.
#PROXY_TYPE=mtproto
#PROXY_HOST=mtproto.example.com
#PROXY_PORT=443
#PROXY_SECRET=abcdef1234zzzzzzzzzzzzz

# ===================================================
# ffmpeg  (join_video.py)
# ===================================================

# Path to the ffmpeg installation directory.
# Binary expected at $FFMPEG_HOME/bin/ffmpeg.exe or $FFMPEG_HOME/ffmpeg.exe.
# Leave empty to use ffmpeg from PATH.
FFMPEG_HOME=C:\Tools\ffmpeg-8.0.1-full_build-shared

# ===================================================
# MCP Server  (mcp_server.py)
# ===================================================

# Bind address and port for the MCP HTTP server.
# Endpoint: http://localhost:MCP_PORT/mcp
MCP_HOST=0.0.0.0
MCP_PORT=3100

# ===================================================
# Ollama LLM  (check_ad.py update)
# ===================================================

# Base URL of the Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Model for ad classification. 9b gives better rule-following than 4b.
OLLAMA_MODEL=qwen3.5:9b
#OLLAMA_MODEL=qwen3.5:4b

# Request timeout in seconds (large prompts can be slow)
OLLAMA_TIMEOUT_SEC=300

# ===================================================
# Video Join Configuration  (join_video.py)
# ===================================================

# Audio/video sync correction in milliseconds.
# Positive: audio is late  → trim start of audio (advance).
# Negative: audio is early → add silence at start (delay).
# 0 = disabled.
AUDIO_DELAY_MS=0

# Nudity filter threshold for join_video.py.
# Video posts with nude_check.nude_rate >= this value are excluded.
# 0.0 = disabled.
NUDE_RATE_THRESHOLD=0.65

# ===================================================
# Interest Score Weights  (--sort interest-asc / interest-desc)
# ===================================================
# Raw score per video:
#   (reactions * W_REACTIONS + forwards * W_FORWARDS + replies * W_REPLIES)
#   / max(views, 1)
# Dividing by views normalises for channel audience size so that videos from
# small channels can outrank videos from large channels on engagement.
# Scores are then min-max normalised to [0, 1] per channel.
INTEREST_W_REACTIONS=10
INTEREST_W_FORWARDS=5
INTEREST_W_REPLIES=1

# ===================================================
# LangSmith tracing  (check_ad.py)
# ===================================================

# Set LANGSMITH_TRACING=true to enable LangSmith observability for LLM calls.
# Get API key at https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=vsnifer

# If smith.langchain.com is not reachable directly, set an HTTP proxy.
# Format: http://user:password@host:port
#LANGSMITH_HTTP_PROXY=http://user:password@proxy.example.com:10126
