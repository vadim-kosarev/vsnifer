# ===================================================
# Telegram API Configuration
# ===================================================

# Telegram API ID
# Get from https://my.telegram.org/apps
# Value: integer (e.g., 123456789)
API_ID=YOUR_API_ID

# Telegram API Hash
# Get from https://my.telegram.org/apps
# Value: string (e.g., abcdef1234567890abcdef1234567890)
API_HASH=abcdef1234567890abcdef1234567890

# ===================================================
# Bot Configuration
# ===================================================

# Bot token from BotFather (@BotFather in Telegram)
# Used to authenticate the bot
BOT_TOKEN=8770438622:AAGG6eUujQuuSKsfs3cgevSNxN1afu_EOxQ

# ===================================================
# Channel Configuration
# ===================================================

# Default channel to monitor (username or ID)
# Examples: +otRtx2aMM0ZlMTVi, @channel_name, 123456789
TARGET_CHANNEL=+otRtx2aMM0ZlMTVi

# Number of recent posts to fetch by default
RECENT_POSTS_COUNT=10

# ===================================================
# Development
# ===================================================

# Debug mode (true/false)
DEBUG=true

