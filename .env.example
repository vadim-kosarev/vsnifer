# ===================================================
# Telegram API Configuration
# ===================================================

# Telegram API ID
# Get from https://my.telegram.org/apps
# Value: integer (e.g., 123456789)
API_ID=YOUR_API_ID

# Telegram API Hash
# Get from https://my.telegram.org/apps
# Value: string (e.g., abcdef1234567890abcdef1234567890)
API_HASH=abcdef1234567890abcdef1234567890

# ===================================================
# Bot Configuration
# ===================================================

# Bot token from BotFather (@BotFather in Telegram)
# Used to authenticate the bot
BOT_TOKEN=8770438622:AAGG6eUujQuuSKsfs3cgevSNxN1afu_EOxQ

# ===================================================
# Channel Configuration
# ===================================================

# Default channel for view-recent / download --channel
# Examples: @channel_name, +otRtx2aMM0ZlMTVi, https://t.me/+xxx, 123456789
TARGET_CHANNEL=+otRtx2aMM0ZlMTVi

# List of channels for batch download (comma-separated, spaces around commas are OK)
# Supported formats: @username, +invite_hash, https://t.me/+xxx, numeric ID
# Example: CHANNELS=@babazoyka, https://t.me/+5wnJFWU8yLZjNTdi, +otRtx2aMM0ZlMTVi
CHANNELS=+otRtx2aMM0ZlMTVi

# Number of recent posts to fetch by default
RECENT_POSTS_COUNT=10

# ===================================================
# Development
# ===================================================

# Debug mode (true/false)
DEBUG=true

PHONE=+79001234567

#PROXY_TYPE=mtproto
#PROXY_HOST=mtproto.example.com
#PROXY_PORT=443
#PROXY_SECRET=xxxxxxxxxx

FFMPEG_HOME=C:\Tools\ffmpeg-8.0.1-full_build-shared
WORK_DIR=H:\TEMP\vk_vsf
