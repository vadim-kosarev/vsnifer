# ===================================================
# Telegram API Configuration
# ===================================================

# Telegram API ID and Hash
# Get from https://my.telegram.org/apps
API_ID=YOUR_API_ID
API_HASH=abcdef1234567890abcdef1234567890

# Phone number for user-session auth (international format)
# Alternative: set BOT_TOKEN below
PHONE=+79001234567

# Bot token from @BotFather (alternative to PHONE)
#BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================================
# Channel Configuration
# ===================================================

# Default channel for view-recent / download --channel
# Examples: @channel_name, +otRtx2aMM0ZlMTVi, https://t.me/+xxx, 123456789
TARGET_CHANNEL=+otRtx2aMM0ZlMTVi

# List of channels for batch download (comma-separated, spaces around commas are OK)
# Supported formats: @username, +invite_hash, https://t.me/+xxx, numeric ID
CHANNELS=+otRtx2aMM0ZlMTVi, @channel2

# Number of recent posts to fetch by default
RECENT_POSTS_COUNT=10

# Work directory for downloaded posts
WORK_DIR=H:\TEMP\vk_vsf

# ===================================================
# Development
# ===================================================

# Debug mode (true/false)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===================================================
# Proxy Configuration
# ===================================================

# Proxy type: mtproto | socks5 | socks4
# Leave commented out to connect directly.
# When proxies are listed in .env.json the bot uses that list instead and
# rotates automatically on connection drops.
PROXY_TYPE=mtproto
#PROXY_HOST=mtproto.example.com
#PROXY_PORT=443
#PROXY_SECRET=abcdef1234567890abcdef1234567890

# ===================================================
# ffmpeg
# ===================================================

# Path to the ffmpeg installation directory.
# The binary is expected at $FFMPEG_HOME/bin/ffmpeg.exe or $FFMPEG_HOME/ffmpeg.exe.
# Leave empty to use ffmpeg from PATH.
FFMPEG_HOME=C:\Tools\ffmpeg-8.0.1-full_build-shared

# ===================================================
# Video Join Configuration  (join_video.py)
# ===================================================

# Audio/video sync correction in milliseconds.
# Positive: audio is late  → trim start of audio (advance).
# Negative: audio is early → add silence at start (delay).
# 0 = disabled.
AUDIO_DELAY_MS=0

# ===================================================
# Interest Score Weights  (--sort interest-asc / interest-desc)
# ===================================================
# Raw score per video:
#   (reactions * W_REACTIONS + forwards * W_FORWARDS + replies * W_REPLIES)
#   / max(views, 1)
# Dividing by views normalises for channel audience size so that videos from
# small channels can outrank videos from large channels on engagement.
# Scores are then globally min-max normalised to [0, 1].
INTEREST_W_REACTIONS=10
INTEREST_W_FORWARDS=5
INTEREST_W_REPLIES=1
